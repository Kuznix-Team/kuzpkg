  - KUZPKG_EVENT_DELTA_INTEGRITY_START, KUZPKG_EVENT_DELTA_INTEGRITY_DONE,
    KUZPKG_EVENT_DELTA_PATCHES_START, KUZPKG_EVENT_DELTA_PATCHES_DONE,
