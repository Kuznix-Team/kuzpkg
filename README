  - klpm_db_get_siglevel()
  - klpm_db_set_usage()
  - klpm_db_get_usage()
  - klpm_pkg_load()
  - klpm_pkg_get_validation()
  - klpm_trans_get_flags()
  - klpm_trans_init()
  - klpm_option_get_local_file_siglevel()
  - klpm_option_set_local_file_siglevel()

[ADDED]
- overwrite support:
  - klpm_option_get_overwrite_files()
  - klpm_option_set_overwrite_files()
  - klpm_option_add_overwrite_file()
  - klpm_option_remove_overwrite_file()
- download timeout control:
