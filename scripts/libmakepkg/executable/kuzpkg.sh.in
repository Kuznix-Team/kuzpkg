[[ -n "$LIBMAKEPKG_EXECUTABLE_KUZPKG_SH" ]] && return
LIBMAKEPKG_EXECUTABLE_KUZPKG_SH=1

MAKEPKG_LIBRARY=${MAKEPKG_LIBRARY:-'@libmakepkgdir@'}

source "$MAKEPKG_LIBRARY/util/message.sh"

executable_functions+=('executable_kuzpkg')

executable_kuzpkg() {
    if (( ! NODEPS || DEP_BIN || RMDEPS || INSTALL )); then
		if [[ -z $KUZPKG_PATH ]]; then
			error "$(gettext "Cannot find the %s binary required for dependency operations.")" "$KUZPKG"
			return 1
		fi
	fi
}
