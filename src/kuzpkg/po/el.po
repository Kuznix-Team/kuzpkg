#, c-format
msgid ""
"      --ignore <pkg>   ignore a package upgrade (can be used more than "
"once)\n"
msgstr ""
"      --ignore <pkg>   παράβλεψη αναβάθμισης πακέτου (επιτρέπεται πολλαπλή "
"χρήση)\n"

